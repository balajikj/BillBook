rules_version = '2';

// BillEasy Firestore Security Rules.
//
// Trust model: every authenticated request carries custom claims
//   - role: 'super-admin' | 'company-admin' | 'company-user'
//   - companyId: string | null (null for super admins)
// set by the `setUserClaims` Cloud Function. Rules NEVER trust client-supplied
// document fields for authorization decisions; only `request.auth.token.*`.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function isSignedIn() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.role;
    }
    function isSuperAdmin() {
      return isSignedIn() && role() == 'super-admin';
    }
    function isCompanyAdmin() {
      return isSignedIn() && role() == 'company-admin';
    }
    function isCompanyUser() {
      return isSignedIn() && role() == 'company-user';
    }
    function isTenantMember(cid) {
      return isSignedIn()
          && request.auth.token.companyId == cid
          && (role() == 'company-admin' || role() == 'company-user');
    }
    function isTenantAdmin(cid) {
      return isSignedIn()
          && request.auth.token.companyId == cid
          && role() == 'company-admin';
    }

    // Helper: incoming document MUST contain exactly the gate fields.
    function hasOnlyGateFields() {
      return request.resource.data.keys().hasOnly(['name', 'status', 'defaultCurrency', 'features', 'createdAt', 'updatedAt'])
          && (!('features' in request.resource.data) || request.resource.data.features is map)
          && request.resource.data.name is string
          && request.resource.data.status in ['active', 'inactive']
          && request.resource.data.defaultCurrency is string
          && request.resource.data.defaultCurrency.size() == 3;
    }

    // Helper: non-admin tenant members may update only the inventory-bearing
    // fields of a product. Used by the invoice-create transaction to debit /
    // credit stock without escalating non-admins to full product write.
    function onlyTouchesInventoryFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['quantity', 'updatedAt'])
          && request.resource.data.quantity is number;
    }

    // Helper: a company-admin's self-service update to their own gate doc.
    // Tighter than `hasOnlyGateFields` — also pins `status` and enforces a
    // stricter format on the editable fields (length 1..120 for name; strict
    // 3-uppercase-letter regex for defaultCurrency). The admin must NOT be
    // able to change status (super-admin only) or add fields outside the
    // whitelist. Code/id is immutable in Firestore (it's the document path).
    function isAdminGateUpdate(cid) {
      return isTenantAdmin(cid)
          && request.resource.data.keys().hasOnly(['name', 'status', 'defaultCurrency', 'features', 'createdAt', 'updatedAt'])
          && request.resource.data.status == resource.data.status
          // Feature flags are an entitlement — super-admin only.
          && request.resource.data.get('features', null) == resource.data.get('features', null)
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 1
          && request.resource.data.name.size() <= 120
          && request.resource.data.defaultCurrency is string
          && request.resource.data.defaultCurrency.matches('^[A-Z]{3}$');
    }

    // ---------- /companies/{cid} (public-readable gate) ----------
    // Anyone (even unauthenticated) may READ the gate document — but it only
    // contains the small set of gate fields (enforced on writes below).
    // Super admins may CREATE/UPDATE/DELETE; company admins of the tenant may
    // UPDATE the cosmetic fields (name, defaultCurrency) of their own gate doc
    // — but never status, never the code, and never new fields.
    match /companies/{cid} {
      allow read: if true;
      allow create: if isSuperAdmin()
                    && cid.matches('^[a-z0-9-]{3,32}$')
                    && hasOnlyGateFields();
      allow update: if (isSuperAdmin() && hasOnlyGateFields())
                    || isAdminGateUpdate(cid);
      allow delete: if isSuperAdmin();

      // ---------- private tenant config (admin-only read/write within tenant) ----------
      match /private/{docId} {
        allow read, write: if isTenantAdmin(cid) || isSuperAdmin();
      }

      // ---------- /companies/{cid}/users — directory of tenant members ----------
      // The Cloud Function writes these documents; clients may read within the
      // tenant. Writes are blocked from clients (only the Admin SDK / Cloud
      // Function path bypasses rules).
      match /users/{uid} {
        allow read: if isTenantMember(cid) || isSuperAdmin();
        allow write: if false;
      }

      // ---------- /companies/{cid}/customers ----------
      match /customers/{customerId} {
        // Tenant members may read customers (non-admins need it for invoice form).
        allow read: if isTenantMember(cid);
        // Only company admins may write.
        allow create, update, delete: if isTenantAdmin(cid);
      }

      // ---------- /companies/{cid}/products ----------
      // Admins manage the full product catalogue. Non-admins (company-user)
      // are additionally permitted to update ONLY the `quantity` and
      // `updatedAt` fields, so that creating an invoice can transactionally
      // adjust inventory.
      match /products/{productId} {
        allow read: if isTenantMember(cid);
        allow create, delete: if isTenantAdmin(cid);
        allow update: if isTenantAdmin(cid)
                      || (isTenantMember(cid) && onlyTouchesInventoryFields());
      }

      // ---------- /companies/{cid}/invoices ----------
      match /invoices/{invoiceId} {
        // Both admins and non-admins read.
        allow read: if isTenantMember(cid);

        // Create: admins and non-admins. The invoice must carry the correct
        // companyId-bound shape and createdBy must equal the caller.
        allow create: if isTenantMember(cid)
                      && request.resource.data.createdBy == request.auth.uid
                      && request.resource.data.status == 'pending';

        // Update: admins may flip status and any field; non-admins may NOT
        // change status. This is the critical authorization rule.
        allow update: if (isTenantAdmin(cid))
                      || (isCompanyUser()
                          && request.auth.token.companyId == cid
                          && request.resource.data.status == resource.data.status);

        // Delete: admins only.
        allow delete: if isTenantAdmin(cid);
      }

      // ---------- /companies/{cid}/counters — per-company invoice number sequence ----------
      match /counters/{counterId} {
        // Read/write by tenant members (the invoice-create transaction needs to
        // increment the counter). Without read access, transactional create
        // can't read the current value.
        allow read: if isTenantMember(cid);
        allow write: if isTenantMember(cid);
      }
    }

    // ---------- /superAdmins/{uid} — directory of platform super admins ----------
    // Written by the Cloud Function only; readable by super admins.
    match /superAdmins/{uid} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ---------- Deny everything else by default ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
